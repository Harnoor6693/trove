# ─────────────────────────────────────────────────────────────────────────
# Trove — deployment configuration.
#
# Run `./trove bootstrap`: it writes `deploy/.env` (chmod 0600) from this file
# with every secret generated. If you copied this file to `deploy/.env` yourself,
# `./trove bootstrap` still works: it fills in only the empty or placeholder
# values and never overwrites one you set.
#
# Rules:
#   * no secret has a default anywhere — compose fails fast, naming the
#     variable, if one is missing (TROVE_ADMIN_PASSWORD and GRAFANA_ADMIN_PASSWORD
#     excepted: see their entries; `./trove up` and `./trove doctor` check them instead);
#   * everything below marked SECRET is generated, never typed;
#   * this file is committed. `deploy/.env` never is;
#   * only the variables in this file reach trove-core (plus the two commented-out
#     ones under "Application behaviour"). Settings that exist only in core/.env.example
#     (trusted proxies, upload and import limits, outbound timeouts, ...) need an extra
#     line in the trove-core `environment:` block of docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────

# ═══ Domain and TLS ══════════════════════════════════════════════════════

# The hostname this install answers on. Used for the Traefik Host() rule,
# the ACME certificate and the default TROVE_PUBLIC_URL (https://<TROVE_DOMAIN>), which is
# also the CORS origin. Cookies are host-only, so browse on exactly this hostname.
# No public domain yet? See "3. Domain and TLS" -> "`off` — no domain yet, via Tailscale"
# in deploy/README.md.
TROVE_DOMAIN=trove.example.com

# Optional. The public base URL members reach Trove on: the base of invite
# links, admin-issued password-reset links, OIDC redirects and the CORS
# origin. Leave it unset and it defaults to https://<TROVE_DOMAIN>. Set it
# only when that is wrong (for example TROVE_TLS_MODE=off behind a proxy
# that serves another hostname or port).
#TROVE_PUBLIC_URL=https://trove.example.com

# Let's Encrypt registration address (expiry warnings land here).
# Required whenever TROVE_TLS_MODE is acme-http or acme-dns.
ACME_EMAIL=you@example.com

# acme-http : HTTP-01. Default. Needs inbound TCP/80 from the internet.
# acme-dns  : DNS-01 via Cloudflare. For CGNAT / no inbound 80 / wildcards.
#             Requires CF_DNS_API_TOKEN below.
# off       : no TLS in Traefik — plain HTTP on the `web` entrypoint, for
#             running behind Tailscale HTTPS or another terminating proxy.
TROVE_TLS_MODE=acme-http

# SECRET (only for TROVE_TLS_MODE=acme-dns). Cloudflare API token scoped to
# Zone:DNS:Edit on the zone of TROVE_DOMAIN. Create at
# https://dash.cloudflare.com/profile/api-tokens
CF_DNS_API_TOKEN=

# Let's Encrypt directory URL. Point at the staging CA while testing so a
# broken setup cannot burn the production rate limit:
#   https://acme-staging-v02.api.letsencrypt.org/directory
TROVE_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Host ports Traefik publishes. Change only if something else already owns
# 80/443 on this box (a fronting proxy, or Tailscale serve).
TROVE_HTTP_PORT=80
TROVE_HTTPS_PORT=443

# Host interface Traefik's ports are published on. Unset means every interface
# (0.0.0.0), except that `./trove` uses 127.0.0.1 when TROVE_TLS_MODE=off, because
# that mode serves cleartext HTTP for a local TLS terminator such as `tailscale serve`.
# Set it explicitly (for example to a LAN address, or 0.0.0.0) to override either default.
# Driving `docker compose` directly instead of `./trove` publishes on 0.0.0.0 in every mode.
#TROVE_BIND_ADDR=127.0.0.1

# Derived from TROVE_TLS_MODE by `./trove`. Set them by hand only if you
# drive `docker compose` directly.
#   acme-http -> websecure / tls.certresolver=letsencrypt-http
#   acme-dns  -> websecure / tls.certresolver=letsencrypt-dns
#   off       -> web       / tls=false
TROVE_ROUTER_ENTRYPOINT=websecure
TROVE_ROUTER_TLS_LABEL=tls.certresolver=letsencrypt-http

# ═══ Database ════════════════════════════════════════════════════════════

# Not secrets. One catalog, one Flyway history.
POSTGRES_USER=trove
POSTGRES_DB=trove

# SECRET — generate: openssl rand -base64 36 | tr -d '\n'
POSTGRES_PASSWORD=

# ═══ Application secrets ═════════════════════════════════════════════════

# SECRET — HS256 signing key for access/refresh tokens. Rotating it logs
# everyone out (and nothing worse). Minimum 32 characters; the app refuses
# to start on the old `change-me-...` literal.
# generate: openssl rand -base64 48 | tr -d '\n'
TROVE_JWT_SECRET=

# SECRET — AES-GCM key for bank credentials, TOTP secrets and OIDC state.
# 64 hex characters. LOSING THIS LOSES EVERY STORED BANK CREDENTIAL: it is
# in the backup archive, and you must also keep a copy somewhere else.
# generate: openssl rand -hex 32
TROVE_ENCRYPTION_KEY=

# First household admin. Consumed only while the `users` table is empty;
# after first boot these are ignored.
TROVE_ADMIN_EMAIL=admin@example.com
# SECRET — generate: openssl rand -base64 24 | tr -d '\n'
# Compose does not require this: you may delete the line once you have signed in and
# changed the password. A brand-new install needs it, or no admin account is created
# (`./trove up` refuses to start one without it).
TROVE_ADMIN_PASSWORD=
# The first admin's country, CA or US. It also sets their currency (CAD or
# USD), and neither can be changed after the first boot.
TROVE_ADMIN_COUNTRY=CA

# ═══ Application behaviour ═══════════════════════════════════════════════

# Self-serve signup. Leave false: the admin invites members from
# Settings -> Household (single-use, 72 h links, no SMTP needed).
TROVE_REGISTRATION_OPEN=false

# Application-level rate limiting (the per-user layer behind Traefik's).
TROVE_RATE_LIMIT_ENABLED=true

# Allow ANY outbound call (per-user AI endpoint, SimpleFIN, webhooks) to
# resolve to a private or loopback address. Link-local addresses (169.254.0.0/16, fe80::/10)
# are refused whatever this is set to. Keep false unless you
# run a model server on your LAN (or use the `ai` profile's Ollama); when true, each user
# must still opt their own endpoint in from Settings -> AI.
TROVE_EGRESS_ALLOW_PRIVATE=false

# Receipt storage quota, megabytes — per HOUSEHOLD, not per user (one shared disk area;
# ReceiptProperties.quotaMb, property trove.receipt.quota-mb, singular "receipt").
TROVE_RECEIPT_QUOTA_MB=2048

# Name of the first household, used once on the first boot (like the admin settings above).
# Commented out = "Household". Add `#` back to return to the default.
#TROVE_HOUSEHOLD_NAME=Household

# Cron (Spring syntax, six fields, always UTC) of the optional scheduled bank sync, which an
# admin turns on in Settings. "-" disables the trigger. Commented out = daily 09:17 UTC.
#TROVE_SIMPLEFIN_SCHEDULED_SYNC_CRON='0 17 9 * * *'

# audit_log rows are purged after 365 days (fixed, not configurable).

# Container clock. Per-user "today"/"this month" boundaries come from each
# user's own timezone setting, not from this.
TZ=UTC

# Optional profiles, comma-separated: ai, monitoring. Empty = neither.
COMPOSE_PROFILES=

# ═══ Storage ═════════════════════════════════════════════════════════════

# Mount point of the `trove_data` volume inside the container:
# receipts/, exports/, uploads/. Created on boot.
TROVE_DATA_DIR=/data

# Where `./trove backup` writes encrypted archives. Put this on a
# different disk than the Docker volumes if you have one, and copy them
# off the box — see deploy/README.md.
TROVE_BACKUP_DIR=./backups

# ═══ Sizing / JVM ════════════════════════════════════════════════════════

# Heap must stay comfortably below TROVE_CORE_MEM_LIMIT (the container is
# killed, not swapped, when it exceeds the limit). 1280m in a 2g limit peaked
# at 81 % under load; on a 4 GB host with memory to spare, see deploy/README.md
# (option A: TROVE_CORE_MEM_LIMIT=2560m with -Xmx1536m).
JAVA_OPTS=-Xmx1280m -XX:+UseZGC
TROVE_CORE_MEM_LIMIT=2g

POSTGRES_MEM_LIMIT=512m
POSTGRES_SHM_SIZE=256mb
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=192MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# Spring profile. `prod` disables the dev-only Flyway relaxations.
SPRING_PROFILES_ACTIVE=prod

# ═══ Optional: OIDC single sign-on ═══════════════════════════════════════
# All-or-nothing: if enabled, issuer/client-id/client-secret must all be
# set or the app refuses to start. Local accounts keep working either way.

TROVE_OIDC_ENABLED=false
TROVE_OIDC_ISSUER_URI=
TROVE_OIDC_CLIENT_ID=
# SECRET — issued by your identity provider.
TROVE_OIDC_CLIENT_SECRET=
TROVE_OIDC_DISPLAY_NAME=

# ═══ Optional: outbound email ════════════════════════════════════════════
# Off by default. Without it: notifications are in-app only and password
# resets are admin-issued links (Settings -> Admin, or the `reset-password` console command). Turning this on
# means Trove talks to your SMTP provider — see "8. What leaves your server" in deploy/README.md.

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SECRET — your SMTP provider's password or app token.
SMTP_PASSWORD=
NOTIFICATION_FROM_ADDRESS=

# ═══ Optional: local AI (COMPOSE_PROFILES=ai) ════════════════════════════
# Starts an Ollama container on the internal `trove_ai` network. Nothing
# uses it until a user sets their endpoint to http://ollama:11434/v1 in
# Settings -> AI. No API key leaves the box in this configuration.
# Requires TROVE_EGRESS_ALLOW_PRIVATE=true (above) and the user enabling the allow-private-endpoint
# option on their AI endpoint; otherwise the server refuses the http://ollama endpoint.

OLLAMA_KEEP_ALIVE=5m
OLLAMA_MEM_LIMIT=4g

# ═══ Optional: monitoring (COMPOSE_PROFILES=monitoring) ══════════════════
# Prometheus and Grafana bind to 127.0.0.1 only; reach them over an SSH
# tunnel. They are never routed through Traefik.

# SECRET — no default. Compose does not require it while the monitoring profile is off, but
# with COMPOSE_PROFILES=monitoring `./trove up` and `./trove doctor` fail until it is set
# (bootstrap generates it); Grafana would otherwise start with an empty admin password.
# generate: openssl rand -base64 24 | tr -d '\n'
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_PORT=3001
PROMETHEUS_BIND_PORT=9091
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=512MB

# ═══ Backup ══════════════════════════════════════════════════════════════

# SECRET — encrypts every backup archive. WITHOUT IT THE BACKUPS ARE
# UNREADABLE. Store it in your password manager, not only here.
# generate: openssl rand -base64 32 | tr -d '\n'
TROVE_BACKUP_PASSPHRASE=

# How many archives to keep in TROVE_BACKUP_DIR. Older ones are deleted
# by `./trove backup` after a successful run.
TROVE_BACKUP_KEEP=7

# Optional: an `age` recipient (age1...). When set and `age` is installed,
# archives are encrypted to this public key instead of the passphrase.
TROVE_BACKUP_AGE_RECIPIENT=
# To restore an .age archive, run `TROVE_BACKUP_AGE_IDENTITY=/path/to/age-identity.txt ./trove restore <archive>`.
# Never keep the identity only on this machine.
