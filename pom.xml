<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>finance.trove</groupId>
    <artifactId>trove</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Trove</name>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <!-- The monolith (docs/recovery/06-COLLAPSE-PLAN.md §1.2). Collapse step 24 deleted
             every other module (services/, libs/, plugins/, tests/integration).
             Step 26 removed the leftover tests/performance/pom.xml (the Gatling suite;
             k6 replaced it) and apps/web/pom.xml
             (orphaned since step 24 dropped its module entry) — neither is on disk any more. -->
        <module>core</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <lombok.version>1.18.48</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.1.1</springdoc.version>
        <openapi-generator.version>7.26.0</openapi-generator.version>
        <jjwt.version>0.13.0</jjwt.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <flyway.version>12.11.0</flyway.version>
