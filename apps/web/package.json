{
  "name": "@trove/web",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build && node scripts/check-csp-compat.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "generate": "openapi-typescript ../../openapi/trove-core.yaml --output src/api/generated/schema.d.ts",
    "check:generated": "npm run generate && git status --porcelain -- src/api/generated | (! grep .)",
    "test:e2e": "playwright test",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui",
    "check:csp": "node scripts/check-csp-compat.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
