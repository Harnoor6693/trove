{
  "name": "@trove/mobile",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint src app --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src app",
    "format:check": "prettier --check src app",
    "build:dev": "eas build --profile development --platform all",
    "build:prev": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "build:ios:debug": "detox build --configuration ios.sim.debug",
    "build:android:debug": "detox build --configuration android.emu.debug",
    "test:eas-config": "jest e2e/eas-config.test.ts --testEnvironment node --testPathIgnorePatterns=/node_modules/",
    "generate": "openapi-typescript ../../openapi/trove-core.yaml -o src/api/generated/schema.d.ts",
    "check:generated": "npm run generate && git status --porcelain -- src/api/generated | (! grep .)",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.11",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.18",
    "expo-splash-screen": "~58.0.9",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "victory-native": "^36.9.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.88.0-rc.4",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/detox": "^18.1.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.51.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.13",
    "jest-junit": "^17.0.0",
    "openapi-typescript": "7.13.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.10",
    "test-renderer": "1.3",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/src/test/setup.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@api/(.*)$": "<rootDir>/src/api/$1",
      "^@design/(.*)$": "<rootDir>/src/design/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@stores/(.*)$": "<rootDir>/src/stores/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@lib/(.*)$": "<rootDir>/src/lib/$1"
    },
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|victory-native|standard-navigation)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/"
    ],
    "globalSetup": "<rootDir>/src/test/globalSetup.js"
  }
}
